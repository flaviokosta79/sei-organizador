{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "SEI Organizador",
  "version": "0.23.17",
  "key": "",
  "description": "Abas por assunto, situação dos processos e alertas de novos processos nos blocos internos do SEI-RJ. Ferramenta não oficial.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "action": {
    "default_title": "SEI Organizador — alertas dos blocos",
    "default_icon": "monitor-icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sei.rj.gov.br/sei/controlador.php*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "activity.js"
      ]
    },
    {
      "matches": [
        "https://sei.rj.gov.br/sei/controlador.php*"
      ],
      "all_frames": true,
      "js": [
        "config.js",
        "users.js",
        "scope.js",
        "history.js",
        "document-data.js",
        "history-pages.js",
        "history-filter.js",
        "document.js",
        "send.js",
        "editing.js"
      ]
    },
    {
      "matches": [
        "https://sei.rj.gov.br/sei/controlador.php*"
      ],
      "js": [
        "theme.js",
        "content.js",
        "pace.js",
        "monitor-data.js",
        "monitor-sounds.js",
        "monitor-settings.js",
        "signature-data.js",
        "signature-monitor.js",
        "receipts-data.js",
        "monitor.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "host_permissions": [
    "https://sei.rj.gov.br/*",
    "https://ext.5cpa.com.br/*",
    "https://api.github.com/*"
  ]
}
