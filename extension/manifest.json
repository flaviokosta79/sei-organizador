{
  "manifest_version": 3,
  "name": "SEI Organizador",
  "version": "0.2.2",
  "description": "Abas compartilhadas por assunto em blocos internos e situação dos documentos no SEI.",
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://sei.rj.gov.br/sei/controlador.php*"
      ],
      "js": [
        "config.js",
        "history.js",
        "theme.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    },
    {
      "matches": [
        "https://sei.rj.gov.br/sei/controlador.php*"
      ],
      "all_frames": true,
      "js": [
        "config.js",
        "history.js",
        "document-data.js",
        "document.js"
      ]
    }
  ],
  "host_permissions": [
    "https://ext.5cpa.com.br/*"
  ]
}
