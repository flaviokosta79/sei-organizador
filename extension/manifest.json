{
  "manifest_version": 3,
  "name": "SEI Organizador",
  "version": "0.1.4",
  "description": "Abas compartilhadas por assunto em blocos internos do SEI.",
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://sei.rj.gov.br/sei/controlador.php*"
      ],
      "js": [
        "config.js",
        "history.js",
        "theme.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "host_permissions": [
    "https://ext.5cpa.com.br/*"
  ]
}
